# MongoDB connection
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DB_NAME=course_preference_portal

# Base URL of the React frontend. Public sharing links are built from this.
FRONTEND_BASE_URL=http://localhost:5173

# Comma-separated list of extra allowed browser origins (local dev origins are
# always allowed through the localhost/127.0.0.1 regex in app/main.py).
CORS_ORIGINS=http://localhost:5173

# Administrator authentication. The backend refuses to start until these are set.
ADMIN_USERNAME=admin
# Preferred: bcrypt hash of the admin password (keep it in single quotes).
# Generate with:
#   python -c "import bcrypt, getpass; print(bcrypt.hashpw(getpass.getpass().encode(), bcrypt.gensalt()).decode())"
ADMIN_PASSWORD_HASH=
# Alternative for local development only: a plaintext password. Ignored when
# ADMIN_PASSWORD_HASH is set.
ADMIN_PASSWORD=

# Secret used to sign admin access tokens (at least 32 characters). Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Number of random bytes in a public sharing token (32 bytes = 256 bits).
PUBLIC_TOKEN_BYTES=32
