# MongoDB connection
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DB_NAME=course_preference_portal

# Base URL of the React frontend. Public sharing links are built from this.
FRONTEND_BASE_URL=http://localhost:5173

# Comma-separated list of extra allowed browser origins (local dev origins are
# always allowed through the localhost/127.0.0.1 regex in app/main.py).
CORS_ORIGINS=http://localhost:5173

# Administrator authentication. Change these before deploying anywhere.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
# Optional: bcrypt hash of the admin password. When supplied it takes precedence
# over ADMIN_PASSWORD. Generate with:
#   python -c "import bcrypt; print(bcrypt.hashpw(b'your-password', bcrypt.gensalt()).decode())"
# ADMIN_PASSWORD_HASH=

# Secret used to sign admin access tokens. Use a long random value in production.
JWT_SECRET=dev-only-insecure-jwt-secret-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Number of random bytes in a public sharing token (32 bytes = 256 bits).
PUBLIC_TOKEN_BYTES=32
